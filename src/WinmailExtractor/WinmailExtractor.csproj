<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\WinmailExtractor.Core\WinmailExtractor.Core.csproj" />
    <EmbeddedResource Include="..\..\docs\THIRD-PARTY-NOTICES.txt" LogicalName="WinmailExtractor.ThirdPartyNotices" />
    <EmbeddedResource Include="..\..\LICENSE" LogicalName="WinmailExtractor.License" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Version>1.0.0-preview.2</Version>
    <Product>Winmail Extractor</Product>
    <Company>PrismEnsembleStudio</Company>
    <Copyright>Copyright (c) 2026 PrismEnsembleStudio</Copyright>
    <Description>端末内で安全にTNEF添付ファイルを展開</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <SatelliteResourceLanguages>ja;en</SatelliteResourceLanguages>
  </PropertyGroup>

</Project>
