<Window x:Class="WinmailExtractor.Views.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="設定 — Winmail Extractor" Style="{StaticResource {x:Type Window}}" Width="620" Height="600" MinWidth="480" MinHeight="450" WindowStartupLocation="CenterOwner">
  <Grid Margin="28">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <TextBlock Text="設定" FontSize="25" FontWeight="SemiBold"/>
        <TextBlock Text="右クリックから、すぐに展開" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,22"/>
        <Border Style="{StaticResource Card}" Padding="22">
          <StackPanel>
            <TextBlock Text="右クリックメニュー連携" FontWeight="SemiBold" FontSize="16"/>
            <TextBlock x:Name="StateText" Margin="0,12,0,12" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap"/>
            <TextBlock Text=".dat ファイルに「Winmail Extractorで開く」を追加します。現在のユーザーのみが対象です。既定のアプリは変更しません。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Margin="0,18,0,0"><Button x:Name="RegisterButton" Content="登録 / 再登録 (_R)" Click="Register" Style="{StaticResource PrimaryButton}"/><Button x:Name="UnregisterButton" Content="解除 (_U)" Click="Unregister" Margin="10,0,0,0"/></StackPanel>
          </StackPanel>
        </Border>
        <TextBlock Text="現在のEXE" FontWeight="SemiBold" FontSize="12" Margin="0,20,0,6"/>
        <TextBox x:Name="CurrentPath" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Foreground="{StaticResource MutedBrush}" Padding="0"/>
        <TextBlock x:Name="RegisteredPath" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,8,0,0"/>
        <TextBlock Text="Windows 11では「その他のオプションを確認」から選択してください。EXEを移動したら、新しい場所から起動して再登録してください。削除する前に連携を解除してください。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,18,0,0" FontSize="12"/>
        <TextBlock x:Name="Notice" TextWrapping="Wrap" Foreground="{StaticResource ErrorBrush}" Margin="0,14,0,0" AutomationProperties.LiveSetting="Polite"/>
        <Expander Header="ライセンス・第三者ソフトウェア" Margin="0,16,0,0" FontSize="12">
          <TextBox x:Name="LicenseText" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="200" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0"/>
        </Expander>
      </StackPanel>
    </ScrollViewer>
    <Button Grid.Row="1" Content="閉じる (_C)" IsCancel="True" HorizontalAlignment="Right" Margin="0,16,0,0"/>
  </Grid>
</Window>
