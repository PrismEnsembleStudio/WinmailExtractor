<Window x:Class="WinmailExtractor.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Winmail Extractor" Style="{StaticResource {x:Type Window}}" Width="920" Height="650" MinWidth="720" MinHeight="500" WindowStartupLocation="CenterScreen"
        AllowDrop="True" PreviewDragOver="OnDragOver" Drop="OnDrop" PreviewKeyDown="OnKeyDown">
  <Grid Margin="30,24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="22"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Border Width="44" Height="44" Background="{StaticResource AccentBrush}" CornerRadius="12" VerticalAlignment="Center">
        <Path Data="M2,5 L22,5 22,19 2,19 Z M2,5 L12,13 22,5 M15,16 L15,24 M11,20 L15,24 19,20" Stroke="White" StrokeThickness="1.5" Width="26" Height="27" Stretch="Uniform"/>
      </Border>
      <StackPanel Grid.Column="1" Margin="14,0,0,0"><TextBlock Text="Winmail Extractor" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="端末内で安全に展開" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0"/></StackPanel>
      <Button Grid.Column="2" Click="OpenSettings" Padding="12" ToolTip="設定" AutomationProperties.Name="設定" IsEnabled="{Binding CanInteract}">
        <Path Data="M2,5 L22,5 M2,12 L22,12 M2,19 L22,19 M8,2 L8,8 M16,9 L16,15 M10,16 L10,22" Stroke="{StaticResource MutedBrush}" StrokeThickness="1.7" Width="20" Height="20" Stretch="Uniform"/>
      </Button>
    </Grid>
    <Border Grid.Row="2" Style="{StaticResource Card}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolVisibility}}" Padding="24">
      <Grid>
        <Rectangle Stroke="{StaticResource LineBrush}" StrokeDashArray="4 5" StrokeThickness="1.5" RadiusX="10" RadiusY="10"/>
        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="18"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
          <Border Background="{StaticResource AccentSoftBrush}" Width="66" Height="66" CornerRadius="20" Margin="0,0,0,20">
            <Path Data="M5,2 L19,2 25,8 25,30 5,30 Z M19,2 L19,8 25,8 M15,13 L15,25 M10,20 L15,25 20,20" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.6" Width="28" Height="32" Stretch="Uniform"/>
          </Border>
          <TextBlock Text="winmail.dat をドロップ" FontSize="23" FontWeight="SemiBold" HorizontalAlignment="Center"/>
          <TextBlock Text="メールの添付ファイルを、必要なものだけ取り出せます。" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,10,0,22"/>
          <Button Content="ファイルを選択 (_O)" Click="ChooseFile" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" IsEnabled="{Binding CanInteract}" ToolTip="Ctrl+O"/>
          <TextBlock Text="TNEF形式 ・ 最大50 MiB" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,16,0,0" HorizontalAlignment="Center"/>
        </StackPanel></Viewbox>
      </Grid>
    </Border>
    <Border Grid.Row="2" Style="{StaticResource Card}" Visibility="{Binding HasFile, Converter={StaticResource BoolVisibility}}" Padding="22,18">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,16,0"><TextBlock Text="{Binding SourceName}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding SourceName}"/><TextBlock Text="{Binding SelectionSummary}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,5,0,0"/></StackPanel>
          <Button Grid.Column="1" Content="別のファイル (_O)" Click="ChooseFile" IsEnabled="{Binding CanInteract}"/>
        </Grid>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,15,0,10" IsEnabled="{Binding CanInteract}">
          <Button Content="全選択 (_A)" Click="SelectAll" Padding="12,5" MinHeight="30" FontSize="12"/>
          <Button Content="選択解除 (_N)" Click="SelectNone" Padding="12,5" MinHeight="30" FontSize="12" Margin="8,0,0,0"/>
        </StackPanel>
        <ListBox Grid.Row="2" ItemsSource="{Binding Attachments}" BorderThickness="0" Background="Transparent" IsEnabled="{Binding CanInteract}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch"
                 VirtualizingPanel.IsVirtualizing="True" AutomationProperties.Name="添付ファイル一覧">
          <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,6"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate><DataTemplate>
            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="8,9">
              <Grid ToolTip="{Binding Tooltip}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="85"/></Grid.ColumnDefinitions>
                <CheckBox IsChecked="{Binding Selected}" AutomationProperties.Name="{Binding FileName}" VerticalAlignment="Center"/>
                <Border Grid.Column="1" Background="{StaticResource AccentSoftBrush}" CornerRadius="7" Height="34" Width="40" VerticalAlignment="Center"><TextBlock Text="{Binding Kind}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="36"/></Border>
                <StackPanel Grid.Column="2" Margin="12,0,8,0" VerticalAlignment="Center"><TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" FontWeight="Medium"/><TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource WarningBrush}" TextTrimming="CharacterEllipsis"/></StackPanel>
                <TextBlock Grid.Column="3" Text="{Binding Size}" Foreground="{StaticResource MutedBrush}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
              </Grid>
            </Border>
          </DataTemplate></ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>
    <StackPanel Grid.Row="3" Margin="0,14,0,0">
      <ProgressBar IsIndeterminate="True" Height="3" Foreground="{StaticResource AccentBrush}" Visibility="{Binding Busy, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,8"/>
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" MaxHeight="76" AutomationProperties.LiveSetting="Polite">
        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsError}" Value="True"><Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
      </TextBlock>
    </StackPanel>
    <Grid Grid.Row="4" Margin="0,18,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center" Margin="0,0,12,0"><TextBlock Text="ファイルは外部へ送信されません" FontSize="11" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="添付ファイルは自動で開きません" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/></StackPanel>
      <Button Grid.Column="1" Content="保存先を開く (_F)" Click="OpenSavedDirectory" Margin="0,0,10,0" Visibility="{Binding HasSavedDirectory, Converter={StaticResource BoolVisibility}}" IsEnabled="{Binding CanInteract}"/>
      <Button Grid.Column="2" Content="選択したファイルを保存 (_S)" Click="SaveFiles" Style="{StaticResource PrimaryButton}" IsEnabled="{Binding CanSave}"/>
    </Grid>
  </Grid>
</Window>
